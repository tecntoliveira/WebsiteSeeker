# Docker Compose
CURB_PORT=3000

# Set true to install the optional OpenCode CLI in the Agentic OS image.
# Leave false for a smaller dashboard/task-only image.
INSTALL_OPENCODE=false

# Required shared secret for Curb -> Agentic OS integration.
# Generate with: openssl rand -hex 32
AGENTIC_OS_API_TOKEN=replace-with-a-long-random-token
